# OlyKube ortam değişkenleri
# Kopyalayın: cp .env.example .env  — sonra değerleri doldurun.
# Değerler Docker Compose'a göredir; yerel çalıştırmada host'ları "localhost" yapın.

# --- PostgreSQL (docker-compose 'db' servisi bu değerlerle kurulur) ---
POSTGRES_USER=olykube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olykube
# Yerel: postgresql://olykube:change-me@localhost:5432/olykube
SQLALCHEMY_DATABASE_URL=postgresql://olykube:change-me@olykube-db:5432/olykube

# --- Redis (rate limiting) ---
# Yerel: localhost
REDIS_HOST=olykube-redis
REDIS_PORT=6379

# --- ChromaDB ---
# Yerel: localhost
CHROMA_HOST=olykube-chromadb
CHROMA_PORT=8000

# --- Yapay Zeka Servisleri ---
# Docker içinden host'taki Ollama'ya: http://host.docker.internal:11434
# Yerel: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
TAVILY_API_KEY=tvly-your-key-here

# --- Güvenlik ---
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
